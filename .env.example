# Fuel App Environment Template
# Копіюйте у .env для локального налаштування

# Перемикач режиму моків (за замовчуванням true, поки бекенд не реалізовано)
VITE_USE_MOCKS=true

# Базовий URL (використовуватиметься пізніше для реального бекенду)
VITE_API_BASE_URL=http://localhost:3000/api

# Секретні ключі сторонніх сервісів (запитуються у людини через HITL за потреби)
# MAPS_API_KEY=
# EXTERNAL_FUEL_API_TOKEN=
