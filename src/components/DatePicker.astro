---
import { formatDateISO, formatDateUkrainian } from '../services/fuelApi';

interface Props {
  currentDate: string;
  formattedDate?: string;
}

const { currentDate, formattedDate: customFormattedDate } = Astro.props;
const formattedDate = customFormattedDate || formatDateUkrainian(currentDate);

// Розрахунок швидких дат
const now = new Date();
const todayISO = formatDateISO(now);

const yesterday = new Date(now);
yesterday.setDate(now.getDate() - 1);
const yesterdayISO = formatDateISO(yesterday);

const weekAgo = new Date(now);
weekAgo.setDate(now.getDate() - 7);
const weekAgoISO = formatDateISO(weekAgo);

const monthAgo = new Date(now);
monthAgo.setDate(now.getDate() - 30);
const monthAgoISO = formatDateISO(monthAgo);

const yearAgo = new Date(now);
yearAgo.setFullYear(now.getFullYear() - 1);
const yearAgoISO = formatDateISO(yearAgo);

const presets = [
  { label: 'Сьогодні', date: todayISO },
  { label: 'Вчора', date: yesterdayISO },
  { label: '7 днів тому', date: weekAgoISO },
  { label: '30 днів тому', date: monthAgoISO },
  { label: 'Рік тому', date: yearAgoISO },
];
---

<section class="hero-control-card glass-card" id="hero-card">
  <!-- Top Loading Progress Bar -->
  <div class="card-loading-bar" id="loading-bar"></div>

  <!-- Glass Overlay Loader -->
  <div class="card-loading-overlay" id="loading-overlay">
    <div class="loading-spinner-box">
      <span class="spinner-icon">⏳</span>
      <span class="loading-text">Застосовуємо дату та завантажуємо ціни...</span>
    </div>
  </div>

  <div class="hero-content">
    <h1 class="hero-title">
      Середні ціни на пальне в Україні на <span class="hero-date">{formattedDate}</span>
    </h1>
  </div>

  <div class="date-picker-bar">
    <form 
      class="custom-date-form" 
      id="date-form" 
      toolname="get_fuel_prices" 
      tooldescription="Отримати або переглянути ціни на пальне в Україні за обрану дату"
      toolautosubmit
    >
      <label for="date-input" class="date-input-label">
        <span class="picker-icon">📅</span>
        <span class="label-text">Змінити дату:</span>
      </label>
      <div class="input-group">
        <input 
          type="date" 
          id="date-input" 
          name="date" 
          value={currentDate} 
          max={todayISO} 
          min="2015-01-01"
          class="date-input"
          toolparamdescription="Дата моніторингу цін у форматі YYYY-MM-DD"
        />
        <button type="submit" class="submit-btn" id="submit-btn">
          <span class="btn-text">Перейти</span>
        </button>
      </div>
    </form>

    <div class="presets-wrapper">
      <span class="presets-label">Швидкий вибір:</span>
      <div class="presets-list">
        {
          presets.map((preset) => {
            const isActive = preset.date === currentDate;
            const href = preset.date === todayISO ? '/' : `/${preset.date}`;
            return (
              <a 
                href={href} 
                class={`preset-btn ${isActive ? 'active' : ''}`}
              >
                {preset.label}
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('date-form') as HTMLFormElement | null;
  const input = document.getElementById('date-input') as HTMLInputElement | null;
  const heroCard = document.getElementById('hero-card');
  const submitBtn = document.getElementById('submit-btn');
  const presetBtns = document.querySelectorAll('.preset-btn');

  if (form && input) {
    const todayISO = new Date().toISOString().split('T')[0];
    input.max = todayISO;

    const showLoader = () => {
      if (heroCard) heroCard.classList.add('is-loading');
      if (submitBtn) {
        (submitBtn as HTMLButtonElement).disabled = true;
      }
    };

    const navigateToDate = (val: string) => {
      if (!val) return;
      showLoader();
      if (val > todayISO) {
        input.value = todayISO;
        window.location.href = '/';
        return;
      }
      window.location.href = val === todayISO ? '/' : `/${val}`;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      navigateToDate(input.value);
    });

    input.addEventListener('change', () => {
      navigateToDate(input.value);
    });

    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const href = (btn as HTMLAnchorElement).getAttribute('href');
        if (href && window.location.pathname !== href) {
          showLoader();
        }
      });
    });
  }
</script>

<style>
  .hero-control-card {
    padding: 2.2rem 2rem;
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  /* Top Loading Bar */
  .card-loading-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    width: 0%;
    background: linear-gradient(90deg, var(--accent-emerald), #34d399);
    transition: width 0.3s ease;
    z-index: 10;
  }

  .is-loading .card-loading-bar {
    width: 100%;
    animation: loadingProgress 1.5s infinite linear;
  }

  @keyframes loadingProgress {
    0% { left: -30%; width: 30%; }
    50% { left: 30%; width: 50%; }
    100% { left: 100%; width: 30%; }
  }

  /* Glass Overlay Loader */
  .card-loading-overlay {
    position: absolute;
    inset: 0;
    background: rgba(11, 15, 25, 0.75);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 20;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .is-loading .card-loading-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .loading-spinner-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.4rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--accent-emerald);
    border-radius: var(--radius-full);
    box-shadow: 0 8px 32px rgba(16, 185, 129, 0.25);
  }

  .spinner-icon {
    font-size: 1.2rem;
    display: inline-block;
    animation: spin 1.2s infinite linear;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .loading-text {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .hero-content {
    max-width: 820px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .hero-date {
    display: block;
    color: var(--accent-emerald);
    margin-top: 0.25rem;
  }

  .date-picker-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }

  .custom-date-form {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .date-input-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .picker-icon {
    font-size: 1.2rem;
  }

  .input-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .date-input {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    padding: 0.55rem 0.85rem;
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s, background 0.2s;
  }

  .date-input:focus {
    border-color: var(--accent-emerald);
    background: rgba(255, 255, 255, 0.09);
  }

  .submit-btn {
    background: var(--accent-emerald);
    color: #0b0f19;
    font-weight: 700;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.88rem;
    transition: opacity 0.2s;
    cursor: pointer;
  }

  .submit-btn:hover {
    opacity: 0.9;
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .presets-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .presets-label {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .presets-list {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .preset-btn {
    font-size: 0.8rem;
    padding: 0.4rem 0.8rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    transition: all 0.2s;
    text-decoration: none;
  }

  .preset-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
  }

  .preset-btn.active {
    background: rgba(16, 185, 129, 0.15);
    border-color: var(--accent-emerald);
    color: var(--accent-emerald);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .date-picker-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .custom-date-form, .presets-wrapper {
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .hero-control-card {
      padding: 1.5rem 1.25rem;
    }
    .hero-title {
      font-size: 1.65rem;
    }
  }
</style>
