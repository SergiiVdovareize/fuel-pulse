---
import type { FuelPrices, FuelDeltas } from '../types/fuel';
import { FUEL_METAS } from '../types/fuel';

interface Props {
  prices: FuelPrices;
  deltas?: FuelDeltas;
  todayPrices?: FuelPrices;
  unit: string;
}

const { prices, deltas, todayPrices, unit } = Astro.props;
---

<div class="prices-grid">
  {
    FUEL_METAS.map((fuel) => {
      const price = prices[fuel.key];
      const isAvailable = typeof price === 'number' && price > 0;
      const delta = deltas ? deltas[fuel.key] : undefined;
      const hasDelta = typeof delta === 'number';
      const isUp = hasDelta && delta! > 0;
      const isDown = hasDelta && delta! < 0;

      const todayPrice = todayPrices ? todayPrices[fuel.key] : undefined;
      const hasTodayComp = isAvailable && typeof todayPrice === 'number' && todayPrice > 0;
      const diffWithToday = hasTodayComp ? Math.round((price - todayPrice!) * 100) / 100 : 0;
      const absDiff = Math.abs(diffWithToday).toFixed(2);
      const formattedDiff = diffWithToday > 0 ? `+${absDiff}` : diffWithToday < 0 ? `-${absDiff}` : `0.00`;

      return (
        <article class="price-card glass-card" style={`--fuel-accent: ${fuel.badgeColor};`}>
          <div class="card-header">
            <div class="header-top">
              <span class="badge" style={`color: ${fuel.badgeColor}; border-color: ${fuel.badgeColor}33; background: ${fuel.badgeColor}15;`}>
                {fuel.shortName}
              </span>
              {hasDelta && (
                <span class={`delta-badge ${isUp ? 'delta-up' : isDown ? 'delta-down' : 'delta-neutral'}`}>
                  {isUp ? `+${delta?.toFixed(2)} ▲` : isDown ? `${delta?.toFixed(2)} ▼` : `0.00`}
                </span>
              )}
            </div>
            <span class="fuel-type-label">{fuel.label}</span>
          </div>

          <div class="card-body">
            {isAvailable ? (
              <div class="price-section">
                <div class="price-wrapper">
                  <span class="price-number">{price.toFixed(2)}</span>
                  <span class="price-unit">{unit}</span>
                </div>
              </div>
            ) : (
              <div class="price-unavailable">
                <span>Немає даних</span>
              </div>
            )}
            <p class="fuel-desc">{fuel.description}</p>
          </div>

          {isAvailable && hasTodayComp && (
            <div class="card-footer-bar">
              <div class="footer-content">
                {formattedDiff} грн.  до сьогодні
              </div>
            </div>
          )}
        </article>
      );
    })
  }
</div>

<style>
  .prices-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    margin: 2rem 0;
  }

  .price-card {
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }

  .price-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--fuel-accent);
    opacity: 0.8;
  }

  .card-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .badge {
    align-self: flex-start;
    padding: 0.25rem 0.6rem;
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    letter-spacing: 0.05em;
  }

  .delta-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }

  .delta-up {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .delta-down {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .delta-neutral {
    background: rgba(148, 163, 184, 0.15);
    color: #94a3b8;
    border: 1px solid rgba(148, 163, 184, 0.3);
  }

  .fuel-type-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .price-section {
    margin-bottom: 0.75rem;
  }

  .price-wrapper {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .price-number {
    font-size: 2.4rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: #ffffff;
  }

  .price-unit {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .card-footer-bar {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
  }

  .footer-content {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .price-unavailable {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .fuel-desc {
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  @media (max-width: 1024px) {
    .prices-grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
  }

  @media (max-width: 640px) {
    .prices-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
