---
import type { FuelPrices } from '../types/fuel';
import { formatDateUkrainian } from '../services/fuelApi';

interface Props {
  dateStr: string;
  effectiveDateStr: string;
  prices: FuelPrices;
}

const { effectiveDateStr, prices } = Astro.props;

const dateFormatted = formatDateUkrainian(effectiveDateStr);

const shareText =
  `⛽️ Середні ціни на пальне в Україні (${dateFormatted}):\n` +
  (prices.a95Premium ? `• А-95+: ${prices.a95Premium.toFixed(2)} грн/л\n` : '') +
  (prices.a95 ? `• А-95: ${prices.a95.toFixed(2)} грн/л\n` : '') +
  (prices.diesel ? `• Дизель: ${prices.diesel.toFixed(2)} грн/л\n` : '') +
  (prices.gas ? `• Газ: ${prices.gas.toFixed(2)} грн/л\n` : '') +
  (prices.a92 ? `• А-92: ${prices.a92.toFixed(2)} грн/л\n` : '') +
  `\nДжерело: FuelPulse`;

const currentUrl = Astro.url.href;
const encodedText = encodeURIComponent(shareText);
const encodedUrl = encodeURIComponent(currentUrl);
---

<div class="share-bar glass-card">
  <div class="share-info">
    <span class="share-icon">📲</span>
    <span class="share-text">Поділитися зведенням цін у месенджерах та соцмережах:</span>
  </div>

  <div class="share-actions">
    <!-- Copy Link Button -->
    <button
      type="button"
      class="action-btn copy-btn"
      id="copy-prices-btn"
      data-text={shareText}
      title="Скопіювати текст у буфер обміну"
    >
      <svg
        class="svg-icon"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span class="btn-label" id="copy-label">
        Скопіювати
      </span>
    </button>

    <!-- Telegram Button -->
    <a
      href={`https://t.me/share/url?url=${encodedUrl}&text=${encodedText}`}
      target="_blank"
      rel="noopener noreferrer"
      class="action-btn telegram-btn"
      title="Поділитися у Telegram"
    >
      <svg class="svg-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.2-.08-.06-.19-.04-.27-.02-.12.02-1.96 1.25-5.54 3.69-.52.36-1 .53-1.42.52-.47-.01-1.37-.26-2.03-.48-.82-.27-1.47-.42-1.42-.88.03-.24.37-.49 1.02-.75 3.99-1.74 6.66-2.89 8.01-3.45 3.81-1.59 4.6-1.87 5.12-1.88.11 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.14-.04.22z" />
      </svg>
      <span class="btn-label">Telegram</span>
    </a>

    <!-- WhatsApp Button -->
    <a
      href={`https://api.whatsapp.com/send?text=${encodeURIComponent(shareText + '\n' + currentUrl)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="action-btn whatsapp-btn"
      title="Поділитися у WhatsApp"
    >
      <svg class="svg-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.84 9.84 0 0 0 12.04 2zm.01 1.67c4.54 0 8.24 3.7 8.24 8.24 0 2.2-.86 4.27-2.42 5.82a8.17 8.17 0 0 1-5.82 2.42c-1.46 0-2.89-.39-4.14-1.13l-.3-.18-3.08.81.82-3-.19-.31A8.2 8.2 0 0 1 3.8 11.9c0-4.54 3.7-8.24 8.25-8.24zm4.52 10.24c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.15.17-.3.19-.55.06-.25-.13-1.06-.39-2.02-1.25-.74-.66-1.24-1.48-1.39-1.73-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.45s-.56-1.35-.77-1.85c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.77 2.7 4.29 3.79.6.26 1.07.41 1.43.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.3z" />
      </svg>
      <span class="btn-label">WhatsApp</span>
    </a>

    <!-- Viber Button -->
    <a
      href={`viber://forward?text=${encodeURIComponent(shareText + '\n' + currentUrl)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="action-btn viber-btn"
      title="Поділитися у Viber"
    >
      <svg class="svg-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M19.78 17.51c-.69-.53-2.06-1.34-2.84-1.46-.43-.07-.94.07-1.29.39l-1.01.99c-3.14-1.21-5.11-3.2-6.3-6.31l.99-1.02c.33-.35.47-.85.39-1.29-.12-.78-.93-2.15-1.46-2.84-.45-.58-.97-.73-1.47-.73-.78 0-1.57.45-2.01 1.16C3.99 7.6 3.49 9.69 4.3 12.87c1.37 5.37 5.46 9.46 10.83 10.83 3.18.81 5.27.31 6.47-.48.71-.44 1.16-1.23 1.16-2.01 0-.5-.15-1.02-.73-1.47zM15 5c2.21 0 4 1.79 4 4h2c0-3.31-2.69-6-6-6v2zm0 4c.55 0 1 .45 1 1h2c0-1.66-1.34-3-3-3v2z" />
      </svg>
      <span class="btn-label">Viber</span>
    </a>

    <!-- Facebook Button -->
    <a
      href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
      target="_blank"
      rel="noopener noreferrer"
      class="action-btn facebook-btn"
      title="Поділитися у Facebook"
    >
      <svg class="svg-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.99 3.66 9.12 8.44 9.88v-6.99H7.9v-2.89h2.54V9.8c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.23.19 2.23.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.89h-2.33v6.99C18.34 21.12 22 16.99 22 12z" />
      </svg>
      <span class="btn-label">Facebook</span>
    </a>

    <!-- X / Twitter Button -->
    <a
      href={`https://twitter.com/intent/tweet?text=${encodedText}&url=${encodedUrl}`}
      target="_blank"
      rel="noopener noreferrer"
      class="action-btn twitter-btn"
      title="Поділитися в X (Twitter)"
    >
      <svg class="svg-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
      </svg>
      <span class="btn-label">X / Twitter</span>
    </a>
  </div>
</div>

<script>
  const copyBtn = document.getElementById('copy-prices-btn');
  const copyLabel = document.getElementById('copy-label');

  if (copyBtn && copyLabel) {
    copyBtn.addEventListener('click', async () => {
      const text = copyBtn.getAttribute('data-text') || '';
      try {
        await navigator.clipboard.writeText(text);
        const originalText = copyLabel.textContent;
        copyLabel.textContent = 'Скопійовано! ✓';
        copyBtn.classList.add('copied');
        setTimeout(() => {
          copyLabel.textContent = originalText;
          copyBtn.classList.remove('copied');
        }, 2500);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });
  }
</script>

<style>
  .share-bar {
    padding: 1.25rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .share-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .share-icon {
    font-size: 1.2rem;
  }

  .share-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.2s ease;
    cursor: pointer;
    text-decoration: none;
  }

  .svg-icon {
    flex-shrink: 0;
  }

  .copy-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
  }

  .copy-btn:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .copy-btn.copied {
    border-color: var(--accent-emerald);
    color: var(--accent-emerald);
  }

  .telegram-btn {
    background: rgba(36, 161, 222, 0.15);
    border: 1px solid rgba(36, 161, 222, 0.3);
    color: #24a1de;
  }

  .telegram-btn:hover {
    background: rgba(36, 161, 222, 0.28);
  }

  .whatsapp-btn {
    background: rgba(37, 211, 102, 0.15);
    border: 1px solid rgba(37, 211, 102, 0.3);
    color: #25d366;
  }

  .whatsapp-btn:hover {
    background: rgba(37, 211, 102, 0.28);
  }

  .viber-btn {
    background: rgba(115, 96, 242, 0.15);
    border: 1px solid rgba(115, 96, 242, 0.3);
    color: #a394f9;
  }

  .viber-btn:hover {
    background: rgba(115, 96, 242, 0.28);
  }

  .facebook-btn {
    background: rgba(24, 119, 242, 0.15);
    border: 1px solid rgba(24, 119, 242, 0.3);
    color: #1877f2;
  }

  .facebook-btn:hover {
    background: rgba(24, 119, 242, 0.28);
  }

  .twitter-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #e2e8f0;
  }

  .twitter-btn:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  @media (max-width: 640px) {
    .share-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .share-actions {
      justify-content: flex-start;
    }
  }
</style>
