---
import type { FuelPrices } from '../types/fuel';
import { FUEL_METAS } from '../types/fuel';
import { formatDateUkrainian } from '../services/fuelApi';

interface Props {
  prices: FuelPrices;
  dateStr?: string;
  formattedDate?: string;
}

const { prices, dateStr, formattedDate: customFormattedDate } = Astro.props;
const displayDate = customFormattedDate || (dateStr ? formatDateUkrainian(dateStr) : undefined);
---

<form 
  class="trip-card glass-card"
  toolname="calculate_trip_cost"
  tooldescription="Розрахувати витрати пального та підсумкову вартість поїздки за відстанню (км) і середньою витратою (л/100км)"
  toolautosubmit
  on-submit="return false;"
>
  <div class="trip-header">
    <div class="trip-icon">🗺️</div>
    <div>
      <h3 class="trip-title">Калькулятор витрат на поїздку</h3>
      <p class="trip-subtitle">
        Розрахуйте вартість маршруту {displayDate ? `за цінами на ${displayDate}` : 'за цінами обраної дати'}
      </p>
    </div>
  </div>

  <div class="trip-inputs-grid">
    <div class="input-field">
      <label for="distance-input">Відстань (км):</label>
      <input 
        type="number" 
        id="distance-input" 
        name="distanceKm"
        value="100" 
        min="1" 
        max="5000" 
        step="10"
        class="custom-input"
        toolparamdescription="Відстань запланованого маршруту в кілометрах (наприклад, 150)"
      />
    </div>

    <div class="input-field">
      <label for="consumption-input">Середня витрата (л/100 км):</label>
      <input 
        type="number" 
        id="consumption-input" 
        name="consumptionPer100km"
        value="7.5" 
        min="1" 
        max="30" 
        step="0.5"
        class="custom-input"
        toolparamdescription="Середня витрата пального автомобілем на 100 км (наприклад, 8.5)"
      />
    </div>

    <div class="input-field">
      <label for="fuel-select">Вид пального:</label>
      <select 
        id="fuel-select" 
        name="fuelType"
        class="custom-input custom-select"
        toolparamdescription="Обраний тип пального (грн/л)"
      >
        {
          FUEL_METAS.map((fuel) => {
            const price = prices[fuel.key];
            if (typeof price === 'number' && price > 0) {
              return (
                <option value={price} selected={fuel.key === 'a95'}>
                  {fuel.label} ({price.toFixed(2)} грн/л)
                </option>
              );
            }
            return null;
          })
        }
      </select>
    </div>
  </div>

  <div class="trip-result-box">
    <div class="result-metric">
      <span class="metric-label">Потрібно пального:</span>
      <span class="metric-value" id="liters-needed">7.5 л</span>
    </div>
    <div class="result-divider"></div>
    <div class="result-metric highlight">
      <span class="metric-label">Орієнтовна вартість поїздки:</span>
      <span class="metric-value"><strong id="trip-total-sum">426</strong> грн</span>
    </div>
  </div>
</form>

<script>
  const distanceInput = document.getElementById('distance-input') as HTMLInputElement | null;
  const consumptionInput = document.getElementById('consumption-input') as HTMLInputElement | null;
  const fuelSelect = document.getElementById('fuel-select') as HTMLSelectElement | null;

  const litersNeeded = document.getElementById('liters-needed');
  const tripTotalSum = document.getElementById('trip-total-sum');

  function calculateTrip() {
    if (!distanceInput || !consumptionInput || !fuelSelect || !litersNeeded || !tripTotalSum) return;

    const distance = parseFloat(distanceInput.value) || 0;
    const consumption = parseFloat(consumptionInput.value) || 0;
    const pricePerLiter = parseFloat(fuelSelect.value) || 0;

    const liters = (distance * consumption) / 100;
    const totalCost = liters * pricePerLiter;

    litersNeeded.textContent = `${liters.toFixed(1)} л`;
    tripTotalSum.textContent = Math.round(totalCost).toLocaleString('uk-UA');
  }

  distanceInput?.addEventListener('input', calculateTrip);
  consumptionInput?.addEventListener('input', calculateTrip);
  fuelSelect?.addEventListener('change', calculateTrip);

  // Initial calculation
  calculateTrip();
</script>

<style>
  .trip-card {
    padding: 1.75rem;
    margin-bottom: 2rem;
  }

  .trip-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .trip-icon {
    font-size: 1.6rem;
  }

  .trip-title {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .trip-subtitle {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .trip-inputs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .input-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .input-field label {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .custom-input {
    min-height: 48px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    padding: 0.65rem 0.9rem;
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .custom-input:focus {
    border-color: var(--accent-emerald);
  }

  .custom-select option {
    background-color: #121826;
    color: #f8fafc;
  }

  .trip-result-box {
    background: rgba(16, 185, 129, 0.06);
    border: 1px solid var(--border-glow);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .result-metric {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .metric-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .metric-value {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .result-metric.highlight .metric-value strong {
    font-size: 2rem;
    color: var(--accent-emerald);
    letter-spacing: -0.02em;
  }

  .result-divider {
    width: 1px;
    height: 40px;
    background: var(--border-subtle);
  }

  @media (max-width: 640px) {
    .result-divider {
      display: none;
    }
    .trip-result-box {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
