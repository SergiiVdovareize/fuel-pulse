---
import Layout from '../layouts/Layout.astro';
import FuelCards from '../components/FuelCards.astro';
import TrendChart from '../components/TrendChart.astro';
import DatePicker from '../components/DatePicker.astro';
import TankCalculator from '../components/TankCalculator.astro';
import TripCalculator from '../components/TripCalculator.astro';
import ShareBar from '../components/ShareBar.astro';
import { fetchFuelPrices, formatDateUkrainian, isValidDateFormat } from '../services/fuelApi';

const { date } = Astro.params;

// Валідація дати
if (!date || !isValidDateFormat(date)) {
  return Astro.redirect('/');
}

// Отримання даних за обрану дату
const data = await fetchFuelPrices(date);
const formattedDate = formatDateUkrainian(data.effectiveDate);

const pageTitle = `Ціни на пальне в Україні на ${formattedDate} — А-95, Дизель, Газ | FuelPulse`;
const pageDescription = `Середня ціна пального в Україні на ${formattedDate}: А-95 — ${data.prices.a95?.toFixed(2) ?? '—'} грн/л, ДП — ${data.prices.diesel?.toFixed(2) ?? '—'} грн/л, Газ — ${data.prices.gas?.toFixed(2) ?? '—'} грн/л. Офіційні дані.`;
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  dateStr={data.requestedDate}
  effectiveDateStr={data.effectiveDate}
  prices={data.prices}
>
  <div class="container">
    <div class="back-nav">
      <a href="/" class="back-link">← Повернутися до актуальних цін</a>
    </div>

    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-badge archive-badge">
        <span>Архівні дані</span>
      </div>

      <h1 class="hero-title">
        Ціни на пальне в Україні на <span class="hero-date">{formattedDate}</span>
      </h1>

      <p class="hero-subtitle">
        Середня роздрібна вартість нафтопродуктів та газу на дату {data.effectiveDate}.
      </p>

      {
        data.effectiveDate !== data.requestedDate && (
          <div class="date-alert">
            ℹ️ На запитану дату ({data.requestedDate}) діяли ціни від {data.effectiveDate} (вихідний або святковий день).
          </div>
        )
      }
    </section>

    <!-- Interactive Date Picker -->
    <DatePicker currentDate={data.effectiveDate} />

    <!-- Main Fuel Price Cards with Deltas -->
    <FuelCards prices={data.prices} deltas={data.deltas} unit={data.unit} />

    <!-- 7/30-Day Trend Chart -->
    {data.history && <TrendChart history={data.history} />}

    <!-- Share Bar -->
    <ShareBar 
      dateStr={data.requestedDate} 
      effectiveDateStr={data.effectiveDate} 
      prices={data.prices} 
    />

    <!-- Calculators Section -->
    <section class="tools-section">
      <TankCalculator prices={data.prices} unit={data.unit} />
      <TripCalculator prices={data.prices} />
    </section>
  </div>
</Layout>

<style>
  .back-nav {
    margin-bottom: 1.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--accent-emerald);
  }

  .hero-section {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 2.5rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
  }

  .archive-badge {
    background: rgba(148, 163, 184, 0.1);
    border: 1px solid rgba(148, 163, 184, 0.25);
    color: var(--text-secondary);
  }

  .hero-title {
    font-size: 2.3rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .hero-date {
    color: var(--accent-emerald);
  }

  .hero-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .date-alert {
    margin-top: 1rem;
    padding: 0.6rem 1rem;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: var(--radius-md);
    color: #fbbf24;
    font-size: 0.85rem;
  }

  .tools-section {
    margin-top: 2rem;
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 1.7rem;
    }
    .hero-subtitle {
      font-size: 0.95rem;
    }
  }
</style>
