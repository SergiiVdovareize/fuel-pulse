---
import Layout from '../layouts/Layout.astro';
import FuelCards from '../components/FuelCards.astro';
import TrendChart from '../components/TrendChart.astro';
import DatePicker from '../components/DatePicker.astro';
import TankCalculator from '../components/TankCalculator.astro';
import TripCalculator from '../components/TripCalculator.astro';
import ShareBar from '../components/ShareBar.astro';
import {
  fetchFuelPrices,
  formatDateUkrainian,
  formatDateISO,
  isValidDateFormat
} from '../services/fuelApi';

const { date } = Astro.params;
const todayISO = formatDateISO(new Date());

// Валідація дати (перевірка формату та заблоковано майбутні дати)
if (!date || !isValidDateFormat(date) || date > todayISO) {
  return Astro.redirect('/');
}

// Отримання даних за обрану дату та за сьогодні (для порівняння)
const [data, todayData] = await Promise.all([fetchFuelPrices(date), fetchFuelPrices()]);

const formattedDate = formatDateUkrainian(data.requestedDate || data.effectiveDate);

const pageTitle = `Ціни на пальне в Україні на ${formattedDate} — А-95, Дизель, Газ | FuelPulse`;
const pageDescription = `Середня ціна пального в Україні на ${formattedDate}: А-95 — ${data.prices.a95?.toFixed(2) ?? '—'} грн/л, ДП — ${data.prices.diesel?.toFixed(2) ?? '—'} грн/л, Газ — ${data.prices.gas?.toFixed(2) ?? '—'} грн/л. Офіційні дані.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  dateStr={data.requestedDate}
  effectiveDateStr={data.effectiveDate}
  prices={data.prices}
>
  <div class="container">
    <!-- Unified Hero Control Card & Date Selector -->
    <DatePicker
      currentDate={data.requestedDate || data.effectiveDate}
      formattedDate={formattedDate}
    />

    {data.hasError && (
      <div class="error-alert">
        ⚠️ На жаль, інформація про ціни на пальне на запитану дату ({data.requestedDate}) відсутня
        або сервіс моніторингу тимчасово недоступний.
      </div>
    )}

    <!-- Main Fuel Price Cards with Deltas and Today Comparison -->
    <FuelCards
      prices={data.prices}
      deltas={data.deltas}
      todayPrices={data.effectiveDate !== todayData.effectiveDate ? todayData.prices : undefined}
      unit={data.unit}
    />

    <!-- 7/30-Day Trend Chart -->
    {data.history && <TrendChart history={data.history} formattedDate={formattedDate} />}

    <!-- Share Bar -->
    <ShareBar
      dateStr={data.requestedDate}
      effectiveDateStr={data.effectiveDate}
      prices={data.prices}
    />

    <!-- Calculators Section -->
    <section class="tools-section">
      <TankCalculator prices={data.prices} unit={data.unit} formattedDate={formattedDate} />
      <TripCalculator prices={data.prices} formattedDate={formattedDate} />
    </section>
  </div>
</Layout>

<style>
  .date-alert {
    margin-top: 1rem;
    padding: 0.6rem 1rem;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: var(--radius-md);
    color: #fbbf24;
    font-size: 0.85rem;
  }

  .error-alert {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: var(--radius-md);
    color: #f87171;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .tools-section {
    margin-top: 2rem;
  }
</style>
