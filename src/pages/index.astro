---
import Layout from '../layouts/Layout.astro';
import FuelCards from '../components/FuelCards.astro';
import TrendChart from '../components/TrendChart.astro';
import DatePicker from '../components/DatePicker.astro';
import TankCalculator from '../components/TankCalculator.astro';
import TripCalculator from '../components/TripCalculator.astro';
import ShareBar from '../components/ShareBar.astro';
import { fetchFuelPrices, formatDateUkrainian, formatDateISO } from '../services/fuelApi';

// Отримуємо поточні ціни на пальне
const todayISO = formatDateISO(new Date());
const data = await fetchFuelPrices(todayISO);
const formattedDate = formatDateUkrainian(data.effectiveDate);

const pageTitle = `Ціни на пальне в Україні на ${formattedDate} — А-95, Дизель, Газ | FuelPulse`;
const pageDescription = `Актуальні середні ціни на пальне в Україні станом на ${formattedDate}: бензин А-95 — ${data.prices.a95?.toFixed(2) ?? '—'} грн/л, дизель — ${data.prices.diesel?.toFixed(2) ?? '—'} грн/л, автогаз — ${data.prices.gas?.toFixed(2) ?? '—'} грн/л. Офіційні дані Мінфіну.`;
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  dateStr={data.requestedDate}
  effectiveDateStr={data.effectiveDate}
  prices={data.prices}
>
  <div class="container">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class={`hero-badge ${data.hasError ? 'error-badge' : ''}`}>
        <span class="pulse-indicator"></span>
        <span>
          {data.hasError ? 'Дані відсутні' : 'Оновлено сьогодні'}
        </span>
      </div>

      <h1 class="hero-title">
        Середні ціни на пальне в Україні на <span class="hero-date">{formattedDate}</span>
      </h1>

      <p class="hero-subtitle">
        Офіційний моніторинг вартості нафтопродуктів та автогазу. Розраховуйте вартість заправки бака та плануйте бюджет поїздок.
      </p>

      {
        data.hasError && (
          <div class="error-alert">
            ⚠️ На жаль, інформація про ціни на пальне на запитану дату ({data.requestedDate}) відсутня або сервіс моніторингу тимчасово недоступний.
          </div>
        )
      }

      {
        !data.hasError && data.effectiveDate !== data.requestedDate && (
          <div class="date-alert">
            ℹ️ Увага: на запитану дату ({data.requestedDate}) діють показники від {data.effectiveDate} (вихідний або святковий день на біржах).
          </div>
        )
      }
    </section>

    <!-- Interactive Date Picker -->
    <DatePicker currentDate={data.effectiveDate} />

    <!-- Main Fuel Price Cards with Deltas -->
    <FuelCards prices={data.prices} deltas={data.deltas} unit={data.unit} />

    <!-- 7/30-Day Trend Chart -->
    {data.history && <TrendChart history={data.history} />}

    <!-- Share Bar -->
    <ShareBar 
      dateStr={data.requestedDate} 
      effectiveDateStr={data.effectiveDate} 
      prices={data.prices} 
    />

    <!-- Calculators Section -->
    <section class="tools-section">
      <TankCalculator prices={data.prices} unit={data.unit} />
      <TripCalculator prices={data.prices} />
    </section>

    <!-- SEO FAQ Section -->
    <section class="faq-section glass-card">
      <h2 class="faq-title">Часті запитання (FAQ)</h2>
      <div class="faq-grid">
        <div class="faq-item">
          <h3>Звідки беруться ціни на пальне?</h3>
          <p>
            Дані базуються на щоденному моніторингу середньозважених роздрібних цін мереж АЗС України, який веде портал Міністерства фінансів (index.minfin.com.ua).
          </p>
        </div>
        <div class="faq-item">
          <h3>Чи враховані персональні знижки мереж (ОККО, WOG тощо)?</h3>
          <p>
            Ні, сервіс відображає ціни на стелі АЗС. За програмами лояльності або додатками мереж реальна вартість заправки може бути на 2–5 грн/л нижчою.
          </p>
        </div>
        <div class="faq-item">
          <h3>Чому ціни можуть не змінюватися кілька днів?</h3>
          <p>
            У вихідні та святкові дні оптові трейдери та біржі не оновлюють котирування, тому на суботу-неділю зазвичай діють зафіксовані п'ятничні ціни.
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .hero-section {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 2.5rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    color: var(--accent-emerald);
    font-weight: 600;
    margin-bottom: 1.25rem;
  }

  .pulse-indicator {
    width: 6px;
    height: 6px;
    background: var(--accent-emerald);
    border-radius: 50%;
  }

  .hero-title {
    font-size: 2.3rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .hero-date {
    color: var(--accent-emerald);
  }

  .hero-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .date-alert {
    margin-top: 1rem;
    padding: 0.6rem 1rem;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: var(--radius-md);
    color: #fbbf24;
    font-size: 0.85rem;
  }

  .error-alert {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: var(--radius-md);
    color: #f87171;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .error-badge {
    background: rgba(239, 68, 68, 0.1) !important;
    border-color: rgba(239, 68, 68, 0.3) !important;
    color: #f87171 !important;
  }

  .error-badge .pulse-indicator {
    background: #ef4444 !important;
  }

  .tools-section {
    margin-top: 2rem;
  }

  .faq-section {
    padding: 2rem;
    margin-top: 2.5rem;
  }

  .faq-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .faq-item h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .faq-item p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 1.7rem;
    }
    .hero-subtitle {
      font-size: 0.95rem;
    }
  }
</style>
